{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searchops.example/schemas/prompt-result.schema.json",
  "title": "SearchOps Prompt Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_id",
    "title",
    "status",
    "started_at",
    "finished_at",
    "summary",
    "tests",
    "files_changed",
    "risks",
    "next_steps"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "completed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
