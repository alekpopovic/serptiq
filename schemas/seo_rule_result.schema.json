{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searchops.example/schemas/seo-rule-result.schema.json",
  "title": "SearchOps SEO Rule Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_key",
    "rule_version",
    "applicability",
    "outcome",
    "severity",
    "confidence",
    "subject",
    "fingerprint",
    "summary",
    "evidence",
    "remediation",
    "verification"
  ],
  "properties": {
    "rule_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "rule_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "warning",
        "unknown"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "minLength": 16
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "value": {},
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "remediation": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
