{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searchops.example/schemas/outgoing-webhook-envelope.schema.json",
  "title": "SearchOps Outgoing Webhook Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "organization_id",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "version": {
      "const": "1"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}
