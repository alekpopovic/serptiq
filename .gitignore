# Prompt tracker runtime lock; state and execution logs remain tracked.
/tracking/.state.lock

# Ruby dependencies and local environment.
/.bundle
/.env*
!/.env.example

# Rails runtime files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/vendor/bundle

# Encryption keys must be supplied outside Git.
/config/master.key
/config/credentials/*.key
