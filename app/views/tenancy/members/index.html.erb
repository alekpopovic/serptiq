<% content_for :title, "Members" %>

<div class="mx-auto max-w-6xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Dashboard", path: organization_dashboard_path(Current.organization.slug) },
    { label: Current.organization.name, path: organization_dashboard_path(Current.organization.slug) },
    { label: "Members", path: nil }
  ] %>
  <div class="mt-6">
    <p class="so-eyebrow">Organization access</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Members</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">This list uses membership display labels only. Invitation controls arrive with the secured invitation workflow.</p>
  </div>

  <div class="so-table-wrap mt-8" role="region" aria-label="Organization members" tabindex="0">
    <table class="so-table">
      <thead><tr><th scope="col">Member</th><th scope="col">Status</th><th scope="col">Accepted</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        <% @membership_page.entries.each do |membership| %>
          <tr>
            <th scope="row" class="font-semibold text-slate-950"><%= membership.display_name %><% if membership.owner? %> <span class="so-badge so-badge-info">Owner</span><% end %></th>
            <td><span class="so-badge so-badge-neutral"><%= membership.status.humanize %></span></td>
            <td><%= membership.accepted_at ? l(membership.accepted_at, format: :long) : "Not accepted" %></td>
            <td class="text-right"><%= link_to "View", organization_member_path(Current.organization.slug, membership.id), class: "so-button so-button-secondary so-button-small" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav class="so-pagination mt-5" aria-label="Member pages">
    <% if @membership_page.previous_page %>
      <%= link_to "Previous", organization_members_path(Current.organization.slug, page: @membership_page.previous_page) %>
    <% end %>
    <span aria-current="page"><%= @membership_page.page %></span>
    <% if @membership_page.next_page %>
      <%= link_to "Next", organization_members_path(Current.organization.slug, page: @membership_page.next_page) %>
    <% end %>
  </nav>
</div>
