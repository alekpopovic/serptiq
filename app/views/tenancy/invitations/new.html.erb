<% content_for :title, "Invite a member" %>

<section class="so-card mx-auto max-w-2xl p-6 sm:p-8" aria-labelledby="new-invitation-title">
  <p class="so-eyebrow">Organization access</p>
  <h1 id="new-invitation-title" class="mt-2 text-3xl font-black tracking-tight text-slate-950">Invite a member</h1>
  <p class="mt-3 text-sm leading-6 text-slate-600">The recipient must sign in with a provider that verifies the exact invited email address.</p>
  <% if @validation_message %><p class="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-900" role="alert"><%= @validation_message %></p><% end %>
  <%= form_with url: organization_invitations_path(Current.organization.slug), class: "mt-6 space-y-5" do |form| %>
    <div><%= form.label :email, "Email address", class: "so-label" %><%= form.email_field :email, required: true, autocomplete: "email", class: "so-input" %></div>
    <div><%= form.label :initial_role_key, "Requested initial access (optional)", class: "so-label" %><%= form.select :initial_role_key, [ [ "No requested role", "" ] ] + @role_keys.map { |key| [ key.humanize, key ] }, {}, class: "so-input" %></div>
    <%= form.submit "Send invitation", class: "so-button so-button-primary" %>
  <% end %>
</section>
