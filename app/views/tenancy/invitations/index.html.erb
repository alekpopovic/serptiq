<% content_for :title, "Invitations" %>

<div class="mx-auto max-w-6xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Dashboard", path: organization_dashboard_path(Current.organization.slug) },
    { label: Current.organization.name, path: organization_dashboard_path(Current.organization.slug) },
    { label: "Invitations", path: nil }
  ] %>
  <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
    <div><p class="so-eyebrow">Organization access</p><h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Invitations</h1></div>
    <% if allowed_to?("members.invite") %>
      <%= link_to "Invite a member", new_organization_invitation_path(Current.organization.slug), class: "so-button so-button-primary" %>
    <% end %>
  </div>
  <div class="so-table-wrap mt-8" role="region" aria-label="Organization invitations" tabindex="0">
    <table class="so-table">
      <thead><tr><th scope="col">Email</th><th scope="col">Status</th><th scope="col">Expires</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr>
            <th scope="row"><%= invitation.email %></th>
            <td><span class="so-badge so-badge-neutral"><%= invitation.status.humanize %></span></td>
            <td><%= l(invitation.expires_at, format: :long) %></td>
            <td><div class="flex justify-end gap-2">
              <% if allowed_to?("members.invite") %>
                <% if invitation.pending? %><%= button_to "Revoke", revoke_organization_invitation_path(Current.organization.slug, invitation.id), method: :patch, class: "so-button so-button-danger so-button-small" %><% end %>
                <% unless invitation.accepted? %><%= button_to "Resend", resend_organization_invitation_path(Current.organization.slug, invitation.id), method: :post, class: "so-button so-button-secondary so-button-small" %><% end %>
              <% end %>
            </div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
