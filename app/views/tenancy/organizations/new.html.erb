<% content_for :title, "Create organization" %>

<div class="mx-auto max-w-3xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Dashboard", path: dashboard_path },
    { label: "Create organization", path: nil }
  ] %>

  <div class="mt-6">
    <p class="so-eyebrow">Organization</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Create an organization</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">The slug becomes part of local SearchOps links. Provider profile data does not grant organization access.</p>
  </div>

  <%= form_with model: @organization, scope: :organization, url: organizations_path, class: "so-card mt-8 space-y-6 p-6 sm:p-8" do |form| %>
    <%= render "shared/error_summary", model: @organization,
      title: "Check the organization details",
      field_ids: { name: "organization_name", slug: "organization_slug", default_locale: "organization_default_locale", time_zone: "organization_time_zone" } %>

    <div>
      <%= form.label :name, "Organization name", class: "so-label" %>
      <%= form.text_field :name, required: true, maxlength: 160, autocomplete: "organization", class: "so-input" %>
    </div>
    <div>
      <%= form.label :slug, "Organization slug", class: "so-label" %>
      <%= form.text_field :slug, required: true, maxlength: 63, autocomplete: "off", class: "so-input", aria: { describedby: "organization-slug-hint" } %>
      <p id="organization-slug-hint" class="so-hint">Use letters, numbers and hyphens. SearchOps normalizes case and spacing; reserved navigation words cannot be used.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :default_locale, "Default language", class: "so-label" %>
        <%= form.select :default_locale, @locales, {}, class: "so-select" %>
      </div>
      <div>
        <%= form.label :time_zone, "Time zone", class: "so-label" %>
        <%= form.select :time_zone, @time_zones, {}, class: "so-select" %>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= form.submit "Create organization", class: "so-button so-button-primary" %>
      <%= link_to "Cancel", onboarding_path, class: "so-button so-button-secondary" %>
    </div>
  <% end %>
</div>
