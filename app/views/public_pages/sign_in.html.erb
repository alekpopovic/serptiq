<% content_for :title, "Sign in" %>

<section class="so-container grid gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-start lg:py-20">
  <div class="max-w-2xl pt-4">
    <span class="so-badge so-badge-neutral">Secure provider sign-in</span>
    <h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950">Sign in to SearchOps</h1>
    <p class="mt-4 text-lg leading-8 text-slate-600">Continue with an external identity provider. SearchOps creates a short-lived, one-time authorization attempt before redirecting you.</p>
    <p class="mt-5 text-sm leading-6 text-slate-500">No password field is shown because SearchOps uses application-owned sessions with external identity providers, not a placeholder password flow.</p>
  </div>

  <div class="so-card p-6 sm:p-8">
    <h2 class="text-lg font-bold text-slate-950">Choose a provider</h2>
    <div class="mt-5 space-y-3">
      <% if @google_sign_in_enabled %>
        <%= button_to "Continue with Google",
          google_oauth_authorization_path,
          params: { return_to: @return_to },
          method: :post,
          class: "so-button so-button-primary w-full" %>
      <% else %>
        <p class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Google sign-in is not configured for this environment.
        </p>
      <% end %>
      <% if @github_sign_in_enabled %>
        <%= button_to "Continue with GitHub",
          github_oauth_authorization_path,
          params: { return_to: @return_to },
          method: :post,
          class: "so-button so-button-secondary w-full" %>
      <% else %>
        <p class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          GitHub sign-in is not configured for this environment.
        </p>
      <% end %>
    </div>
    <p class="mt-5 text-xs leading-5 text-slate-500">SearchOps never asks for or stores your provider password.</p>
  </div>
</section>
