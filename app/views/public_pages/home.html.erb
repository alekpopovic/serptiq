<% content_for :title, "Product foundation" %>

<section class="relative overflow-hidden border-b border-slate-200 bg-slate-950 text-white">
  <div class="so-container grid gap-12 py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center lg:py-28">
    <div>
      <span class="so-badge so-badge-info">Foundation scaffold</span>
      <h1 class="mt-6 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">An accessible shell for evidence-led search operations.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">This is the application foundation, not a finished product dashboard. Organization, project, scan and finding workflows are connected in later implementation prompts.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Sign in", sign_in_path, class: "so-button so-button-primary" %>
        <%= link_to "View dashboard shell", dashboard_path, class: "so-button so-button-inverse" %>
      </div>
    </div>

    <div class="so-card border-white/10 bg-white/5 p-6 text-white shadow-2xl shadow-teal-950/30">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-300">Interface contract</p>
      <dl class="mt-5 space-y-5">
        <div>
          <dt class="font-semibold">Server rendered</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-300">Navigation and forms remain useful without client-side JavaScript.</dd>
        </div>
        <div>
          <dt class="font-semibold">Source specific</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-300">Future views distinguish observations, provider data, heuristics and guarantees.</dd>
        </div>
        <div>
          <dt class="font-semibold">Keyboard first</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-300">Landmarks, visible focus and reduced-motion behavior are part of the base layer.</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<section class="so-container py-14 sm:py-18" aria-labelledby="foundation-capabilities">
  <div class="max-w-2xl">
    <p class="so-eyebrow">Ready for real workflows</p>
    <h2 id="foundation-capabilities" class="mt-2 text-3xl font-black tracking-tight text-slate-950">A calm frame for complex operational evidence.</h2>
  </div>
  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <% [
      [ "Evidence before score", "Future findings show what was observed, when and by which rule version." ],
      [ "Meaning stays explicit", "Live fetches, rendered pages and provider-known state are never presented as the same fact." ],
      [ "Actions stay bounded", "Long work moves to isolated jobs while the web interface remains responsive." ]
    ].each do |title, body| %>
      <article class="so-card p-6">
        <h3 class="font-bold text-slate-950"><%= title %></h3>
        <p class="mt-2 text-sm leading-6 text-slate-600"><%= body %></p>
      </article>
    <% end %>
  </div>
</section>
