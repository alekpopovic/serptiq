<% content_for :title, "Dashboard scaffold" %>

<div class="mx-auto max-w-7xl">
  <% if Current.organization %>
    <%= render "shared/breadcrumbs", items: [
      { label: "Dashboard", path: dashboard_path },
      { label: Current.organization.name, path: nil }
    ] %>
  <% end %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="so-eyebrow">Authenticated workspace</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Dashboard</h1>
      <% if Current.organization %>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Verified organization: <strong><%= Current.organization.name %></strong>. Access was established through your active membership, not from the route slug alone.</p>
      <% else %>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Choose one of your verified organizations to establish workspace context.</p>
      <% end %>
    </div>
    <span class="so-badge so-badge-neutral">Signed in</span>
  </div>

  <%= turbo_frame_tag "dashboard-shell" do %>
    <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="so-card p-6 sm:p-8">
        <% if Current.organization %>
          <section class="so-empty-state" aria-labelledby="workspace-empty-title">
            <div class="mx-auto grid size-12 place-items-center rounded-xl bg-teal-50 text-xl text-teal-800" aria-hidden="true">◇</div>
            <h2 id="workspace-empty-title" class="mt-4 text-lg font-bold text-slate-950">Organization context verified</h2>
            <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-600">Projects keep related web and mobile properties inside one authorization and reporting boundary.</p>
            <% if allowed_to?("projects.create") %>
              <%= link_to "Create project", organization_project_onboarding_path(Current.organization.slug), class: "so-button so-button-primary mt-5" %>
            <% else %>
              <%= link_to "View accessible projects", organization_projects_path(Current.organization.slug), class: "so-button so-button-secondary mt-5" %>
            <% end %>
          </section>
        <% else %>
          <section aria-labelledby="workspace-empty-title">
            <h2 id="workspace-empty-title" class="text-lg font-bold text-slate-950">Choose an organization</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Only organizations tied to your active membership are shown. Suspended organizations remain visible but cannot be opened or changed.</p>
            <ul class="mt-5 divide-y divide-slate-100">
              <% @organization_navigation.each do |entry| %>
                <li class="flex items-center justify-between gap-4 py-3">
                  <span class="font-semibold text-slate-900"><%= entry.name %></span>
                  <% if entry.available? %>
                    <%= link_to "Open", organization_dashboard_path(entry.slug), class: "so-button so-button-secondary so-button-small" %>
                  <% else %>
                    <span class="so-badge so-badge-warning"><%= entry.status_label %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <%= link_to "Create organization", new_organization_path, class: "so-button so-button-primary mt-5" %>
          </section>
        <% end %>
      </div>

      <aside class="so-card p-6" aria-labelledby="shell-status-title">
        <h2 id="shell-status-title" class="font-bold text-slate-950">Shell status</h2>
        <ul class="mt-4 space-y-3 text-sm text-slate-600">
          <li class="flex gap-2"><span class="text-teal-700" aria-hidden="true">●</span><span>Semantic landmarks active</span></li>
          <li class="flex gap-2"><span class="text-teal-700" aria-hidden="true">●</span><span>Responsive navigation active</span></li>
          <li class="flex gap-2"><span class="text-teal-700" aria-hidden="true">●</span><span><%= Current.organization ? "Tenant membership verified" : "Tenant data intentionally absent" %></span></li>
        </ul>
      </aside>
    </div>
  <% end %>
</div>
