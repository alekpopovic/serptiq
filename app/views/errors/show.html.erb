<% content_for :title, "Request could not be completed" %>

<section class="so-page-section" aria-labelledby="public-error-title">
  <div class="so-card mx-auto max-w-2xl p-6 sm:p-8">
    <p class="so-kicker">Request status</p>
    <h1 id="public-error-title" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950"><%= error.fetch(:title) %></h1>
    <p class="mt-3 text-slate-700"><%= error.fetch(:message) %></p>
    <p class="mt-5 font-mono text-sm text-slate-600">
      Error code: <%= error.fetch(:code) %>
    </p>
    <% if error[:request_id] %>
      <p class="mt-2 font-mono text-xs text-slate-500">Request ID: <%= error.fetch(:request_id) %></p>
    <% end %>
    <div class="mt-6">
      <% if error[:action] == :sign_in %>
        <%= link_to "Start sign-in again", sign_in_path, class: "so-button so-button-primary" %>
      <% elsif error[:action] == :quota && Current.organization %>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Review usage", organization_usage_path(Current.organization.slug), class: "so-button so-button-primary" %>
          <%= link_to "Compare plans", organization_plan_comparison_path(Current.organization.slug), class: "so-button so-button-secondary" %>
          <%= link_to "Return to existing workspace", organization_dashboard_path(Current.organization.slug), class: "so-button so-button-secondary" %>
        </div>
      <% else %>
        <%= link_to "Return to home", root_path, class: "so-button so-button-secondary" %>
      <% end %>
    </div>
  </div>
</section>
