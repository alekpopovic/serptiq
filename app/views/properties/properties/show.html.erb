<% content_for :title, @property_summary.display_name %>
<% project_readable = allowed_to?("projects.read", project: @project) %>

<div class="mx-auto max-w-5xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Projects", path: (organization_projects_path(Current.organization.slug) if project_readable) },
    { label: (project_readable ? @project.name : "Project"), path: (organization_project_path(Current.organization.slug, @project.slug) if project_readable) },
    { label: "Properties", path: organization_project_properties_path(Current.organization.slug, @project.slug) },
    { label: @property_summary.display_name, path: nil }
  ] %>
  <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
    <div><p class="so-eyebrow"><%= @property_summary.kind.humanize %></p><h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950"><%= @property_summary.display_name %></h1></div>
    <span class="so-badge <%= @property_summary.active? ? "so-badge-success" : "so-badge-neutral" %>"><%= @property_summary.status.humanize %></span>
  </div>

  <section class="so-card mt-8 p-6" aria-labelledby="property-configuration-title">
    <h2 id="property-configuration-title" class="font-bold text-slate-950">Typed configuration</h2>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
      <% @property_summary.configuration.to_h.each do |name, value| %>
        <div><dt class="text-slate-500"><%= name.to_s.humanize %></dt><dd class="mt-1 break-all font-mono text-slate-900"><%= value %></dd></div>
      <% end %>
      <div><dt class="text-slate-500">Verification</dt><dd class="mt-1 text-slate-900"><%= @property_summary.verification_status.humanize %></dd></div>
    </dl>
    <p class="mt-4 text-xs leading-5 text-slate-500">Verification is an observed, revocable state. Creating a property does not prove ownership.</p>
  </section>

  <% unless @property_summary.active? %>
    <div class="so-alert so-alert-warning mt-7">
      <p>This property is read-only and cannot start new scans.</p>
      <% if @property_summary.pending_deletion? && @deletion_status %>
        <p class="mt-2">Retained history remains reviewable until approximately <%= l(@deletion_status.hold_until, format: :long) %>. Export anything you need before cleanup begins.</p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8 flex flex-wrap gap-3">
    <% if @property.kind.in?(%w[website web_application]) %>
      <%= link_to (@property_summary.active? ? "Manage environments" : "View environments"), organization_project_property_environments_path(Current.organization.slug, @project.slug, @property.id), class: "so-button so-button-secondary" %>
    <% end %>
    <% if @property_summary.active? && allowed_to?("properties.manage", project: @project, property: @property) %>
      <%= link_to "Edit property", edit_organization_project_property_path(Current.organization.slug, @project.slug, @property.id), class: "so-button so-button-primary" %>
      <%= button_to "Archive property", archive_organization_project_property_path(Current.organization.slug, @project.slug, @property.id), method: :patch, class: "so-button so-button-secondary", form: { data: { turbo_confirm: "Archive this property and disable new scans?" } } %>
    <% elsif @property_summary.archived? && allowed_to?("properties.manage", project: @project, property: @property) %>
      <%= button_to "Reactivate property", reactivate_organization_project_property_path(Current.organization.slug, @project.slug, @property.id), method: :patch, class: "so-button so-button-primary" %>
    <% end %>
    <% if @property_summary.pending_deletion? && @deletion_status&.cancelable && allowed_to?("projects.delete", project: @project, property: @property) %>
      <%= button_to "Cancel deletion", cancel_deletion_organization_project_property_path(Current.organization.slug, @project.slug, @property.id), method: :patch, class: "so-button so-button-secondary" %>
    <% elsif !@property_summary.pending_deletion? && allowed_to?("projects.delete", project: @project, property: @property) %>
      <%= link_to "Request deletion", deletion_organization_project_property_path(Current.organization.slug, @project.slug, @property.id), class: "so-button so-button-danger" %>
    <% end %>
  </div>
</div>
