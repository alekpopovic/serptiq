<% content_for :title, "Add environment" %>
<div class="mx-auto max-w-3xl">
  <%= render "shared/breadcrumbs", items: [
    { label: @property.display_name, path: organization_project_property_path(Current.organization.slug, @project.slug, @property.id) },
    { label: "Environments", path: organization_project_property_environments_path(Current.organization.slug, @project.slug, @property.id) },
    { label: "Add", path: nil }
  ] %>
  <h1 class="mt-6 text-3xl font-black tracking-tight text-slate-950">Add environment</h1>
  <%= form_with model: @environment, scope: :environment, url: organization_project_property_environments_path(Current.organization.slug, @project.slug, @property.id), class: "mt-8 space-y-6" do |form| %>
    <%= render "form", form: form, environment: @environment, environment_kinds: @environment_kinds %>
    <%= form.submit "Create environment", class: "so-button so-button-primary" %>
  <% end %>
</div>
