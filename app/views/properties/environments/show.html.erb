<% content_for :title, @environment_summary.display_name %>
<div class="mx-auto max-w-5xl">
  <%= render "shared/breadcrumbs", items: [
    { label: @property.display_name, path: organization_project_property_path(Current.organization.slug, @project.slug, @property.id) },
    { label: "Environments", path: organization_project_property_environments_path(Current.organization.slug, @project.slug, @property.id) },
    { label: @environment_summary.display_name, path: nil }
  ] %>
  <div class="mt-6 flex flex-wrap items-start justify-between gap-4"><div><p class="so-eyebrow"><%= @environment_summary.kind.humanize %> · <%= @environment_summary.key %></p><h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950"><%= @environment_summary.display_name %></h1></div><div class="flex gap-2"><% if @environment_summary.primary? %><span class="so-badge so-badge-success">Primary</span><% end %><span class="so-badge <%= @environment_summary.active? ? "so-badge-success" : "so-badge-neutral" %>"><%= @environment_summary.status.humanize %></span></div></div>
  <section class="so-card mt-8 p-6"><h2 class="font-bold text-slate-950">Canonical origin</h2><dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">Display</dt><dd class="mt-1 break-all font-mono"><%= @environment_summary.origin.display_origin %></dd></div><div><dt class="text-slate-500">ASCII network form</dt><dd class="mt-1 break-all font-mono"><%= @environment_summary.origin.origin %></dd></div><div><dt class="text-slate-500">Effective port</dt><dd class="mt-1"><%= @environment_summary.origin.port %></dd></div></dl><p class="mt-4 text-xs text-slate-500">Canonical parsing is not a network-safety guarantee. Every scan destination must still pass DNS and address policy checks.</p></section>
  <div class="mt-8 flex flex-wrap gap-3">
    <% if @environment_summary.active? && allowed_to?("properties.manage", project: @project, property: @property) %><%= link_to "Edit environment", edit_organization_project_property_environment_path(Current.organization.slug, @project.slug, @property.id, @environment.id), class: "so-button so-button-primary" %><% unless @environment_summary.primary? %><%= button_to "Archive environment", archive_organization_project_property_environment_path(Current.organization.slug, @project.slug, @property.id, @environment.id), method: :patch, class: "so-button so-button-secondary" %><% end %><% elsif @environment_summary.archived? && allowed_to?("properties.manage", project: @project, property: @property) %><%= button_to "Reactivate environment", reactivate_organization_project_property_environment_path(Current.organization.slug, @project.slug, @property.id, @environment.id), method: :patch, class: "so-button so-button-primary" %><% end %>
  </div>
</div>
