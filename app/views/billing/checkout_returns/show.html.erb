<% content_for :title, "Checkout received" %>

<div class="mx-auto max-w-3xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Dashboard", path: organization_dashboard_path(Current.organization.slug) },
    { label: "Plans", path: organization_plan_comparison_path(Current.organization.slug) },
    { label: "Checkout return", path: nil }
  ] %>

  <section class="so-card mt-6 p-6" aria-labelledby="checkout-return-title" role="status">
    <p class="so-eyebrow">Billing confirmation pending</p>
    <h1 id="checkout-return-title" class="mt-2 text-3xl font-black tracking-tight text-slate-950">Your checkout was received</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600">
      Returning here does not prove payment and did not change your access. SearchOps updates billing only
      after a signed provider event is verified and applied to the local subscription record.
    </p>
    <% if @subscription %>
      <p class="mt-4 rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-700">
        Current local billing state: <strong><%= @subscription.plan_display_name %></strong>
        (<%= @subscription.status.humanize %>).
      </p>
    <% end %>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "View plan status", organization_plan_comparison_path(Current.organization.slug), class: "so-button so-button-primary" %>
      <%= link_to "Return to dashboard", organization_dashboard_path(Current.organization.slug), class: "so-button so-button-secondary" %>
    </div>
  </section>
</div>
