<% content_for :title, "Projects" %>

<div class="mx-auto max-w-7xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Dashboard", path: organization_dashboard_path(Current.organization.slug) },
    { label: "Projects", path: nil }
  ] %>
  <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="so-eyebrow">Organization workspace</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Projects</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600">Only projects granted through your organization or explicit project roles are listed.</p>
    </div>
    <% if allowed_to?("projects.create") %>
      <%= link_to "Create project", new_organization_project_path(Current.organization.slug), class: "so-button so-button-primary" %>
    <% end %>
  </div>

  <%= form_with url: organization_projects_path(Current.organization.slug), method: :get, class: "so-card mt-7 flex flex-col gap-3 p-4 sm:flex-row sm:items-end" do |form| %>
    <div class="flex-1">
      <%= form.label :q, "Search projects", class: "so-label" %>
      <%= form.search_field :q, value: @project_page.query, maxlength: 80, placeholder: "Name or slug", class: "so-input" %>
    </div>
    <%= form.submit "Search", class: "so-button so-button-secondary" %>
  <% end %>

  <% if @project_page.entries.any? %>
    <div class="so-table-wrap mt-6" role="region" aria-label="Organization projects" tabindex="0">
      <table class="so-table">
        <thead><tr><th scope="col">Project</th><th scope="col">Status</th><th scope="col">Properties</th><th scope="col">Latest scan</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
          <% @project_page.entries.each do |project| %>
            <tr>
              <th scope="row"><span class="font-semibold text-slate-950"><%= project.name %></span><span class="mt-1 block font-mono text-xs font-normal text-slate-500"><%= project.slug %></span></th>
              <td><span class="so-badge <%= project.active? ? "so-badge-success" : "so-badge-neutral" %>"><%= project.status.humanize %></span></td>
              <td><%= project.property_count %></td>
              <td><%= project.latest_scan_at ? l(project.latest_scan_at) : "No scan observation yet" %></td>
              <td class="text-right"><%= link_to "View", organization_project_path(Current.organization.slug, project.slug), class: "so-button so-button-secondary so-button-small" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <section class="so-empty-state mt-8" aria-labelledby="projects-empty-title">
      <h2 id="projects-empty-title" class="text-lg font-bold text-slate-950">No accessible projects</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-600">Create a project if permitted, or ask an organization administrator for an explicit project role.</p>
    </section>
  <% end %>

  <nav class="so-pagination mt-5" aria-label="Project pages">
    <% if @project_page.previous_page %><%= link_to "Previous", organization_projects_path(Current.organization.slug, page: @project_page.previous_page, q: @project_page.query) %><% end %>
    <span aria-current="page"><%= @project_page.page %></span>
    <% if @project_page.next_page %><%= link_to "Next", organization_projects_path(Current.organization.slug, page: @project_page.next_page, q: @project_page.query) %><% end %>
  </nav>
</div>
