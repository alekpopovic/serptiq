<% content_for :title, "Confirm project deletion" %>

<div class="mx-auto max-w-3xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Projects", path: organization_projects_path(Current.organization.slug) },
    { label: @project.name, path: organization_project_path(Current.organization.slug, @project.slug) },
    { label: "Confirm deletion", path: nil }
  ] %>

  <section class="so-card mt-6 p-6 sm:p-8" aria-labelledby="project-deletion-title">
    <p class="so-eyebrow">Destructive action</p>
    <h1 id="project-deletion-title" class="mt-2 text-3xl font-black tracking-tight text-slate-950">Confirm project deletion</h1>
    <div class="so-alert so-alert-warning mt-6">
      <p><strong>Archive or export anything you need first.</strong> New schedules and scans stop immediately. Existing work receives a cooperative cancellation signal.</p>
      <p class="mt-2">A retention hold lasts until approximately <%= l(@deletion_hold_until, format: :long) %>. During it, qualifying organization-level readers can review retained history and an authorized user can cancel. After it, cleanup runs asynchronously across integrations, scans/findings, reports, object artifacts, credentials/endpoints and aggregate records.</p>
      <p class="mt-2">Billing and security audit evidence may remain as minimized tombstone history under the approved retention policy.</p>
    </div>

    <% if @confirmation_error %><div class="so-alert so-alert-danger mt-5" role="alert"><%= @confirmation_error %></div><% end %>
    <%= form_with url: organization_project_path(Current.organization.slug, @project.slug), method: :delete, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :confirmation, "Enter the project slug #{@project.slug} to confirm", class: "so-label" %>
        <%= form.text_field :confirmation, required: true, autocomplete: "off", class: "so-input" %>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= form.submit "Request project deletion", class: "so-button so-button-danger" %>
        <%= link_to "Keep project", organization_project_path(Current.organization.slug, @project.slug), class: "so-button so-button-secondary" %>
      </div>
    <% end %>
  </section>
</div>
