<% content_for :title, "Plan comparison" %>

<div class="mx-auto max-w-7xl">
  <%= render "shared/breadcrumbs", items: [
    { label: "Dashboard", path: organization_dashboard_path(Current.organization.slug) },
    { label: Current.organization.name, path: organization_dashboard_path(Current.organization.slug) },
    { label: "Plans", path: nil }
  ] %>

  <div class="mt-6">
    <p class="so-eyebrow">Billing and entitlements</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Compare plans</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
      Published local catalog data is shown here. A selected price is not a charge and no plan changes until
      hosted checkout and a verified provider event confirm it.
    </p>
    <% if @portal_available && allowed_to?("billing.manage") %>
      <div class="mt-4">
        <%= button_to "Manage billing with provider",
          organization_billing_portal_path(Current.organization.slug),
          method: :post,
          class: "so-button so-button-secondary" %>
        <p class="mt-2 text-xs text-slate-500">The provider creates a short-lived customer portal link.</p>
      </div>
    <% end %>
  </div>

  <% if @billing_status %>
    <section class="so-card mt-6 p-5" aria-labelledby="billing-status-title" role="status">
      <div class="flex flex-wrap items-center gap-3">
        <h2 id="billing-status-title" class="font-bold text-slate-950"><%= @billing_status.label %></h2>
        <span class="so-badge <%= @billing_status.access_state == "full" ? "so-badge-success" : "so-badge-warning" %>">
          <%= @billing_status.access_state.humanize %> access
        </span>
      </div>
      <p class="mt-2 text-sm leading-6 text-slate-700"><%= @billing_status.message %></p>
      <% if @billing_status.effective_at %>
        <p class="mt-1 text-sm text-slate-600">
          Effective time recorded locally: <time datetime="<%= @billing_status.effective_at.iso8601 %>"><%= l(@billing_status.effective_at, format: :long) %></time>.
        </p>
      <% end %>
      <% if @billing_status.remediation %>
        <p class="mt-2 text-sm font-medium text-slate-800"><%= @billing_status.remediation %></p>
      <% end %>
      <% if @billing_status.plan_change %>
        <p class="mt-2 text-sm text-slate-700">
          A <%= @billing_status.plan_change.direction %> is <%= @billing_status.plan_change.state %> and remains
          on the current plan until confirmed by a provider event.
        </p>
      <% end %>
      <p class="mt-2 text-xs text-slate-500">
        This is the latest confirmed local billing observation; the provider portal is authoritative for payment, tax and invoice details.
      </p>
    </section>
  <% end %>

  <% if @active_checkout %>
    <div class="so-card mt-6 border-amber-200 bg-amber-50 p-5" role="status">
      <h2 class="font-bold text-amber-950">A hosted checkout is already in progress</h2>
      <p class="mt-1 text-sm text-amber-900">Finish or let that short-lived checkout expire before starting another one.</p>
    </div>
  <% end %>

  <% if @selected_offer %>
    <div class="so-card mt-6 border-teal-200 bg-teal-50 p-5" role="status">
      <h2 class="font-bold text-teal-950"><%= @selected_offer.display_name %> selected for review</h2>
      <p class="mt-1 text-sm text-teal-900">
        No checkout has started and the current plan is unchanged. The hosted provider page displays the
        authoritative total, taxes and payment terms before purchase.
      </p>
      <% if @selected_interval && allowed_to?("billing.manage") && !@active_checkout &&
          @checkout_availability.fetch(@selected_offer.id).fetch(@selected_interval) %>
        <% if @subscription&.provider_backed? %>
          <% unless @billing_status&.plan_change %>
            <%= button_to "Request #{@selected_offer.direction_from(@current_offer)}",
              organization_billing_plan_change_path(Current.organization.slug),
              method: :post,
              params: {
                plan_change: {
                  target_plan_key: @selected_offer.plan_key,
                  target_plan_version_id: @selected_offer.id,
                  currency: @selected_offer.currency,
                  billing_interval: @selected_interval
                }
              },
              class: "so-button so-button-primary mt-4" %>
          <% end %>
        <% else %>
          <%= button_to "Continue to secure #{@selected_interval} checkout",
            organization_billing_checkout_path(Current.organization.slug),
            method: :post,
            params: {
              checkout: {
                plan_version_id: @selected_offer.id,
                currency: @selected_offer.currency,
                billing_interval: @selected_interval
              }
            },
            class: "so-button so-button-primary mt-4" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @offers.empty? %>
    <div class="so-card mt-8 p-6" role="status">
      <h2 class="font-bold text-slate-950">No published plan offers are available</h2>
      <p class="mt-2 text-sm text-slate-600">Existing access remains readable according to subscription policy.</p>
    </div>
  <% else %>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-5">
      <% @offers.each do |offer| %>
        <% direction = offer.direction_from(@current_offer) %>
        <article class="so-card flex flex-col p-5 <%= "ring-2 ring-teal-600" if offer.current? %>" aria-labelledby="organization-plan-<%= offer.id %>">
          <div class="flex flex-wrap gap-2">
            <% if offer.current? %><span class="so-badge so-badge-success">Current plan</span><% end %>
            <% if offer.grandfathered? %><span class="so-badge so-badge-warning">Grandfathered</span><% end %>
            <% if offer.offered? %><span class="so-badge so-badge-neutral">Published v<%= offer.version %></span><% end %>
          </div>
          <h2 id="organization-plan-<%= offer.id %>" class="mt-4 text-xl font-black text-slate-950"><%= offer.display_name %></h2>
          <p class="mt-2 min-h-16 text-sm leading-6 text-slate-600"><%= offer.positioning %></p>
          <% if offer.current? && offer.grandfathered? %>
            <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">Existing access remains attached to this exact version until an explicit migration.</p>
          <% end %>

          <% if offer.custom_pricing? %>
            <p class="mt-5 text-xl font-black">Custom pricing</p>
            <p class="mt-1 text-xs text-slate-500">Requires an explicit contract and configured limits.</p>
          <% else %>
            <dl class="mt-5 space-y-2 text-sm">
              <div><dt class="inline text-slate-500">Monthly:</dt> <dd class="inline font-bold"><%= display_price(offer.monthly_price_cents, offer.currency) %></dd></div>
              <div><dt class="inline text-slate-500">Annual:</dt> <dd class="inline font-bold"><%= display_price(offer.annual_price_cents, offer.currency) %></dd></div>
            </dl>
          <% end %>

          <div class="mt-auto pt-6">
            <% if offer.current? %>
              <span class="so-button so-button-secondary w-full" aria-disabled="true">Current plan</span>
            <% elsif !allowed_to?("billing.manage") %>
              <p class="text-sm text-slate-600">Ask a billing administrator to change plans.</p>
            <% elsif @active_checkout %>
              <span class="so-button so-button-secondary w-full opacity-60" aria-disabled="true">Checkout in progress</span>
            <% elsif offer.custom_pricing? %>
              <%= link_to "Review contract requirements", organization_entitlements_path(Current.organization.slug), class: "so-button so-button-secondary w-full" %>
            <% else %>
              <div class="grid gap-2">
                <% offer.billing_intervals.each do |interval| %>
                  <% if @checkout_availability.fetch(offer.id).fetch(interval) %>
                    <%= link_to "#{direction.titleize} — #{interval.titleize}",
                      organization_plan_comparison_path(Current.organization.slug, target_plan_key: offer.plan_key, billing_interval: interval),
                      class: "so-button so-button-primary w-full" %>
                  <% else %>
                    <span class="so-button so-button-secondary w-full opacity-60" aria-disabled="true"><%= interval.titleize %> checkout unavailable</span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="so-card mt-10 overflow-hidden" aria-labelledby="organization-feature-comparison-title">
      <div class="border-b border-slate-200 bg-slate-50 px-5 py-4">
        <h2 id="organization-feature-comparison-title" class="font-bold text-slate-950">Effective catalog comparison</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
          <thead class="text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="sticky left-0 bg-white px-5 py-3">Feature or limit</th>
              <% @offers.each do |offer| %><th class="min-w-40 px-5 py-3"><%= offer.display_name %> v<%= offer.version %></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% @entitlement_definitions.each do |definition| %>
              <tr>
                <th class="sticky left-0 min-w-72 bg-white px-5 py-4 font-normal">
                  <span class="font-semibold text-slate-950"><%= definition.description %></span>
                  <span class="mt-1 block font-mono text-xs text-slate-500"><%= definition.key %></span>
                </th>
                <% @offers.each do |offer| %>
                  <% value = offer.entitlement_value(definition.key) %>
                  <% state = definition.state(value) %>
                  <td class="px-5 py-4"><span class="so-badge <%= commercial_state_badge(state) %>"><%= definition.display(value) %></span></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
