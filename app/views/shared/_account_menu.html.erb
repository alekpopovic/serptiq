<details class="group relative">
  <summary class="so-button so-button-secondary so-button-small list-none [&::-webkit-details-marker]:hidden">
    <span class="grid size-6 place-items-center rounded-full bg-slate-200 text-xs font-bold text-slate-700" aria-hidden="true">A</span>
    <span><%= label %></span>
    <span class="text-slate-400 transition group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">⌄</span>
  </summary>
  <div class="absolute right-0 top-12 z-30 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
    <p class="px-3 py-2 text-xs leading-5 text-slate-500">Signed in as <%= Current.user.display_name.presence || "SearchOps user" %>.</p>
    <%= link_to "Account details", account_profile_path, class: "so-menu-link" %>
    <%= link_to "Account security", account_security_path, class: "so-menu-link" %>
    <%= link_to "Sessions", account_sessions_path, class: "so-menu-link" %>
    <%= link_to "Public home", root_path, class: "so-menu-link" %>
    <%= button_to "Sign out", logout_path, method: :delete, class: "so-menu-link w-full text-left" %>
  </div>
</details>
