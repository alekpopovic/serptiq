<section class="so-empty-state" aria-labelledby="<%= heading_id %>">
  <div class="mx-auto grid size-12 place-items-center rounded-xl bg-teal-50 text-xl text-teal-800" aria-hidden="true">◇</div>
  <h2 id="<%= heading_id %>" class="mt-4 text-lg font-bold text-slate-950"><%= title %></h2>
  <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-600"><%= body %></p>
  <% if action.present? %>
    <div class="mt-5"><%= action %></div>
  <% end %>
</section>
