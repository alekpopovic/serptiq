<nav class="<%= mobile ? '' : 'px-3 py-5' %>" aria-label="Workspace navigation">
  <ul class="space-y-1">
    <% items.each do |item| %>
      <li>
        <%= link_to item.fetch(:label), item.fetch(:path),
          class: "so-sidebar-link",
          aria: { current: current_path == item.fetch(:path) ? "page" : nil } %>
      </li>
    <% end %>
  </ul>
</nav>
