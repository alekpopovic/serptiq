<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
    <% items.each_with_index do |item, index| %>
      <li class="flex items-center gap-2">
        <span aria-hidden="true"><%= index.zero? ? "" : "/" %></span>
        <% if item[:path].present? %>
          <%= link_to item.fetch(:label), item.fetch(:path), class: "font-semibold hover:text-slate-950" %>
        <% else %>
          <span aria-current="page"><%= item.fetch(:label) %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
