<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
  <head>
    <%= render "shared/document_head", title: content_for(:title).presence || "SearchOps" %>
  </head>

  <body class="min-h-full antialiased <%= content_for(:body_class) %>">
    <a class="so-skip-link" href="#main-content" data-turbo="false">Skip to main content</a>

    <% if content_for?(:shell) %>
      <%= yield :shell %>
    <% else %>
      <main id="main-content" class="so-container py-10" tabindex="-1">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
