<% content_for :body_class, "bg-slate-100 text-slate-950" %>
<% organization_path = Current.organization && organization_dashboard_path(Current.organization.slug) %>
<% if Current.organization %>
  <% organization_navigation_items = [
    *(navigation_allowed_to?("organization.read") ? [ { label: "Dashboard", path: organization_path } ] : []),
    *(project_navigation_available? ? [ { label: "Projects", path: organization_projects_path(Current.organization.slug) } ] : []),
    *(navigation_allowed_to?("members.read") ? [ { label: "Members", path: organization_members_path(Current.organization.slug) } ] : []),
    *(navigation_allowed_to?("members.read") ? [ { label: "Invitations", path: organization_invitations_path(Current.organization.slug) } ] : []),
    *(navigation_allowed_to?("teams.read") ? [ { label: "Teams", path: organization_teams_path(Current.organization.slug) } ] : []),
    *(navigation_allowed_to?("plans.read") ? [ { label: "Plans", path: organization_plan_comparison_path(Current.organization.slug) } ] : []),
    *(navigation_allowed_to?("billing.read") ? [ { label: "Usage", path: organization_usage_path(Current.organization.slug) } ] : []),
    *(navigation_allowed_to?("organization.read") ? [ { label: "Organization settings", path: organization_settings_path(Current.organization.slug) } ] : [])
  ] %>
<% else %>
  <% organization_navigation_items = [
    { label: "Dashboard", path: dashboard_path },
    { label: "Get started", path: onboarding_path }
  ] %>
<% end %>
<% navigation_items = [
  *organization_navigation_items,
  { label: "Account details", path: account_profile_path },
  { label: "Account security", path: account_security_path },
  { label: "Sessions", path: account_sessions_path }
] %>
<% content_for :shell do %>
  <div class="min-h-screen lg:grid lg:grid-cols-[17rem_minmax(0,1fr)]">
    <aside class="hidden border-r border-slate-200 bg-slate-950 text-white lg:flex lg:min-h-screen lg:flex-col" aria-label="Workspace">
      <div class="border-b border-white/10 px-6 py-5">
        <%= render "shared/brand", compact: false, inverted: true %>
      </div>
      <%= render "shared/app_navigation", items: navigation_items, current_path: request.path, mobile: false %>
      <p class="mt-auto px-6 py-5 text-xs leading-5 text-slate-400">Organization links are generated from verified membership context.</p>
    </aside>

    <div class="min-w-0">
      <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="flex min-h-16 items-center gap-3 px-4 sm:px-6 lg:px-8">
          <details class="group relative lg:hidden">
            <summary class="so-icon-button list-none [&::-webkit-details-marker]:hidden" aria-label="Open workspace navigation">
              <span aria-hidden="true">☰</span>
            </summary>
            <div class="absolute left-0 top-12 z-30 w-72 rounded-xl border border-slate-200 bg-slate-950 p-3 text-white shadow-xl">
              <%= render "shared/app_navigation", items: navigation_items, current_path: request.path, mobile: true %>
            </div>
          </details>

          <div class="lg:hidden">
            <%= render "shared/brand", compact: true, inverted: false %>
          </div>

          <div class="min-w-0 flex-1">
            <details class="group relative inline-block">
              <summary class="so-button so-button-secondary so-button-small list-none [&::-webkit-details-marker]:hidden" aria-label="Choose organization">
                <span class="max-w-48 truncate"><%= Current.organization&.name || "Choose organization" %></span>
                <span aria-hidden="true">⌄</span>
              </summary>
              <div class="absolute left-0 top-12 z-30 w-72 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
                <p class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Your organizations</p>
                <% organization_navigation_entries.each do |entry| %>
                  <% if entry.available? %>
                    <%= link_to organization_switch_path_for(entry), class: "so-menu-link flex items-center justify-between gap-3" do %>
                      <span class="truncate"><%= entry.name %></span>
                      <% if Current.organization&.id == entry.id %><span aria-label="Current organization">✓</span><% end %>
                    <% end %>
                  <% else %>
                    <div class="flex items-center justify-between gap-3 px-3 py-2 text-sm text-slate-500">
                      <span class="truncate"><%= entry.name %></span>
                      <span class="so-badge so-badge-warning"><%= entry.status_label %></span>
                    </div>
                  <% end %>
                <% end %>
                <%= link_to "Create organization", new_organization_path, class: "so-menu-link mt-1 border-t border-slate-100 pt-3" %>
              </div>
            </details>
          </div>

          <%= render "shared/account_menu", label: Current.user.display_name.presence || "Account" %>
        </div>
      </header>

      <%= render "shared/flash_region", flash_messages: flash %>

      <main id="main-content" class="px-4 py-8 sm:px-6 lg:px-8" tabindex="-1">
        <%= yield %>
      </main>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
