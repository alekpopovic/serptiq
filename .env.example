# Local development defaults. This is a variable-name contract, not a file to
# source in staging or production. Secret values intentionally remain blank.
SEARCHOPS_APPLICATION_NAME=SearchOps
SEARCHOPS_APPLICATION_ORIGIN=http://localhost:3000
SEARCHOPS_DATABASE_ROLE=web
RAILS_MAX_THREADS=5
SEARCHOPS_DATABASE_HOST=
SEARCHOPS_DATABASE_PORT=5432
SEARCHOPS_DATABASE_USERNAME=searchops
SEARCHOPS_PRIMARY_DATABASE_POOL=5
SEARCHOPS_QUEUE_DATABASE_POOL=5
SEARCHOPS_CACHE_DATABASE_POOL=2
SEARCHOPS_CABLE_DATABASE_POOL=2
SEARCHOPS_DATABASE_PROCESS_COUNT=1
SEARCHOPS_DATABASE_RESERVED_CONNECTIONS=5
SEARCHOPS_DATABASE_CONNECTION_BUDGET=25
SEARCHOPS_DATABASE_CONNECT_TIMEOUT_SECONDS=3
SEARCHOPS_DATABASE_CHECKOUT_TIMEOUT_SECONDS=3
SEARCHOPS_DATABASE_STATEMENT_TIMEOUT_MS=15000
SEARCHOPS_DATABASE_LOCK_TIMEOUT_MS=5000
SEARCHOPS_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
SEARCHOPS_DATABASE_HEALTH_TIMEOUT_MS=1000
SEARCHOPS_DATABASE_ADVISORY_LOCKS=true
SEARCHOPS_JOB_THREADS=3
SEARCHOPS_JOB_PROCESSES=1
SEARCHOPS_OBJECT_STORAGE_SERVICE=local
SEARCHOPS_CRAWLER_MAX_URLS_PER_SCAN=10000
SEARCHOPS_CRAWLER_CONNECT_TIMEOUT=5s
SEARCHOPS_CRAWLER_READ_TIMEOUT=20s
SEARCHOPS_CRAWLER_MAX_RESPONSE_BYTES=10485760
SEARCHOPS_CRAWLER_MAX_REDIRECTS=5
SEARCHOPS_CRAWLER_CONCURRENCY=8
SEARCHOPS_BROWSER_TIMEOUT=45s
SEARCHOPS_BROWSER_MEMORY_MB=1024
SEARCHOPS_BROWSER_MAX_REQUESTS=200
SEARCHOPS_BROWSER_CONCURRENCY=2
SEARCHOPS_DNS_VERIFICATION_ENABLED=true
SEARCHOPS_DNS_VERIFICATION_TIMEOUT=3s
SEARCHOPS_DNS_VERIFICATION_MAX_RECORDS=32
SEARCHOPS_DNS_VERIFICATION_MAX_RESPONSE_BYTES=4096
SEARCHOPS_DNS_VERIFICATION_MAX_CNAME_HOPS=5
SEARCHOPS_DNS_VERIFICATION_MAX_DELEGATIONS=8
SEARCHOPS_OAUTH_GOOGLE_ENABLED=false
SEARCHOPS_OAUTH_GITHUB_ENABLED=false
SEARCHOPS_OAUTH_HTTP_OPEN_TIMEOUT=2s
SEARCHOPS_OAUTH_HTTP_READ_TIMEOUT=5s
SEARCHOPS_OAUTH_HTTP_MAX_RESPONSE_BYTES=262144
SEARCHOPS_OAUTH_HTTP_SAFE_RETRIES=2
SEARCHOPS_OAUTH_JWKS_CACHE_TTL=5m
SEARCHOPS_OAUTH_JWKS_MAX_KEYS=16
SEARCHOPS_OAUTH_OIDC_CLOCK_SKEW=60s
SEARCHOPS_OAUTH_OIDC_MAX_TOKEN_LIFETIME=2h
SEARCHOPS_OAUTH_TRANSACTION_TTL=10m
SEARCHOPS_OAUTH_TRANSACTION_RETENTION=24h
SEARCHOPS_OAUTH_START_RATE_WINDOW=5m
SEARCHOPS_OAUTH_START_MAX_PER_IP=20
SEARCHOPS_OAUTH_START_MAX_PER_SESSION=10
SEARCHOPS_OAUTH_START_MAX_OPEN_PER_IP=5
SEARCHOPS_OAUTH_START_MAX_OPEN_PER_SESSION=2
SEARCHOPS_AUTH_CALLBACK_FAILURE_RATE_WINDOW=5m
SEARCHOPS_AUTH_CALLBACK_FAILURE_MAX_PER_IP=10
SEARCHOPS_AUTH_SESSION_ACTION_RATE_WINDOW=5m
SEARCHOPS_AUTH_SESSION_ACTION_MAX_PER_SESSION=30
SEARCHOPS_AUTH_ACCOUNT_SECURITY_RATE_WINDOW=5m
SEARCHOPS_AUTH_ACCOUNT_SECURITY_MAX_PER_SESSION=20
SEARCHOPS_BILLING_PROVIDER=disabled
# `fake` is accepted only in development/test; protected environments require a real configured adapter.
SEARCHOPS_BILLING_HTTP_OPEN_TIMEOUT=2s
SEARCHOPS_BILLING_HTTP_READ_TIMEOUT=5s
SEARCHOPS_BILLING_HTTP_WRITE_TIMEOUT=5s
SEARCHOPS_BILLING_HTTP_MAX_RESPONSE_BYTES=524288
SEARCHOPS_SEARCH_CONSOLE_ENABLED=false
SEARCHOPS_PAGESPEED_ENABLED=false
SEARCHOPS_CRUX_ENABLED=false
SEARCHOPS_EMAIL_DELIVERY_METHOD=log
SEARCHOPS_EMAIL_FROM=development@localhost
SEARCHOPS_SLACK_ENABLED=false
RAILS_LOG_LEVEL=info
SEARCHOPS_TRACING_ENABLED=false
SEARCHOPS_PROCESS_ROLE=web

# Production/staging public configuration (no usable deployment values).
SEARCHOPS_OBJECT_STORAGE_BUCKET=
SEARCHOPS_OBJECT_STORAGE_REGION=
SEARCHOPS_OBJECT_STORAGE_ENDPOINT=
SEARCHOPS_OAUTH_GOOGLE_CLIENT_ID=
SEARCHOPS_OAUTH_GITHUB_CLIENT_ID=
SEARCHOPS_BILLING_STORE_ID=
SEARCHOPS_ENCRYPTION_KEY_VERSION=v1
SEARCHOPS_SMTP_HOST=
SEARCHOPS_SMTP_PORT=587
SEARCHOPS_SMTP_USERNAME=
SEARCHOPS_SLACK_CLIENT_ID=
SEARCHOPS_OBSERVABILITY_ENDPOINT=
SEARCHOPS_RELEASE_SHA=
SEARCHOPS_BUILD_TIMESTAMP=

# Runtime secrets: inject these or use matching Rails credentials paths.
DATABASE_URL=
QUEUE_DATABASE_URL=
CACHE_DATABASE_URL=
CABLE_DATABASE_URL=
SEARCHOPS_DATABASE_PASSWORD=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
SEARCHOPS_OBJECT_STORAGE_ACCESS_KEY_ID=
SEARCHOPS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEYS=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
SEARCHOPS_OAUTH_GOOGLE_CLIENT_SECRET=
SEARCHOPS_OAUTH_GITHUB_CLIENT_SECRET=
SEARCHOPS_PROVIDER_GOOGLE_API_KEY=
SEARCHOPS_BILLING_API_KEY=
SEARCHOPS_BILLING_WEBHOOK_SECRET=
# Optional during a controlled signing-secret rotation; remove after provider cutover.
SEARCHOPS_BILLING_WEBHOOK_PREVIOUS_SECRET=
SEARCHOPS_SMTP_PASSWORD=
SEARCHOPS_SLACK_CLIENT_SECRET=
SEARCHOPS_SLACK_SIGNING_SECRET=
SEARCHOPS_OBSERVABILITY_AUTH_TOKEN=
SEARCHOPS_WEBHOOK_SIGNING_KEYS=
