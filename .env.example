# Local development defaults. This is a variable-name contract, not a file to
# source in staging or production. Secret values intentionally remain blank.
SEARCHOPS_APPLICATION_NAME=SearchOps
SEARCHOPS_APPLICATION_ORIGIN=http://localhost:3000
SEARCHOPS_DATABASE_ROLE=web
RAILS_MAX_THREADS=5
SEARCHOPS_OBJECT_STORAGE_SERVICE=local
SEARCHOPS_CRAWLER_MAX_URLS_PER_SCAN=10000
SEARCHOPS_CRAWLER_CONNECT_TIMEOUT=5s
SEARCHOPS_CRAWLER_READ_TIMEOUT=20s
SEARCHOPS_CRAWLER_MAX_RESPONSE_BYTES=10485760
SEARCHOPS_CRAWLER_MAX_REDIRECTS=5
SEARCHOPS_CRAWLER_CONCURRENCY=8
SEARCHOPS_BROWSER_TIMEOUT=45s
SEARCHOPS_BROWSER_MEMORY_MB=1024
SEARCHOPS_BROWSER_MAX_REQUESTS=200
SEARCHOPS_BROWSER_CONCURRENCY=2
SEARCHOPS_OAUTH_GOOGLE_ENABLED=false
SEARCHOPS_OAUTH_GITHUB_ENABLED=false
SEARCHOPS_BILLING_PROVIDER=disabled
SEARCHOPS_SEARCH_CONSOLE_ENABLED=false
SEARCHOPS_PAGESPEED_ENABLED=false
SEARCHOPS_CRUX_ENABLED=false
SEARCHOPS_EMAIL_DELIVERY_METHOD=log
SEARCHOPS_EMAIL_FROM=development@localhost
SEARCHOPS_SLACK_ENABLED=false
RAILS_LOG_LEVEL=info
SEARCHOPS_TRACING_ENABLED=false
SEARCHOPS_PROCESS_ROLE=web

# Production/staging public configuration (no usable deployment values).
SEARCHOPS_OBJECT_STORAGE_BUCKET=
SEARCHOPS_OBJECT_STORAGE_REGION=
SEARCHOPS_OBJECT_STORAGE_ENDPOINT=
SEARCHOPS_OAUTH_GOOGLE_CLIENT_ID=
SEARCHOPS_OAUTH_GITHUB_CLIENT_ID=
SEARCHOPS_BILLING_STORE_ID=
SEARCHOPS_ENCRYPTION_KEY_VERSION=v1
SEARCHOPS_SMTP_HOST=
SEARCHOPS_SMTP_PORT=587
SEARCHOPS_SMTP_USERNAME=
SEARCHOPS_SLACK_CLIENT_ID=
SEARCHOPS_OBSERVABILITY_ENDPOINT=
SEARCHOPS_RELEASE_SHA=
SEARCHOPS_BUILD_TIMESTAMP=

# Runtime secrets: inject these or use matching Rails credentials paths.
DATABASE_URL=
SEARCHOPS_DATABASE_PASSWORD=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
SEARCHOPS_OBJECT_STORAGE_ACCESS_KEY_ID=
SEARCHOPS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEYS=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
SEARCHOPS_OAUTH_GOOGLE_CLIENT_SECRET=
SEARCHOPS_OAUTH_GITHUB_CLIENT_SECRET=
SEARCHOPS_PROVIDER_GOOGLE_API_KEY=
SEARCHOPS_BILLING_API_KEY=
SEARCHOPS_BILLING_WEBHOOK_SECRET=
SEARCHOPS_SMTP_PASSWORD=
SEARCHOPS_SLACK_CLIENT_SECRET=
SEARCHOPS_SLACK_SIGNING_SECRET=
SEARCHOPS_OBSERVABILITY_AUTH_TOKEN=
SEARCHOPS_WEBHOOK_SIGNING_KEYS=
