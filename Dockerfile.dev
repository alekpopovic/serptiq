# syntax=docker/dockerfile:1
# check=error=true

ARG RUBY_VERSION=4.0.5
FROM docker.io/library/ruby:$RUBY_VERSION-slim@sha256:42ad5227a4b2758f32563b34b5967e1055e75c80243eef04e6d2572887d1dec4

WORKDIR /rails

ARG CHROMIUM_PACKAGE_VERSION=152.0.7977.75-1~deb13u1
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential chromium="$CHROMIUM_PACKAGE_VERSION" chromium-sandbox="$CHROMIUM_PACKAGE_VERSION" curl git libpq-dev libvips libyaml-dev postgresql-client pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

LABEL io.searchops.chromium.package-version="$CHROMIUM_PACKAGE_VERSION" \
      io.searchops.ferrum.version="0.18.0"

ENV BINDING="0.0.0.0" \
    BUNDLE_PATH="/usr/local/bundle" \
    PORT="3000" \
    RAILS_ENV="development"

COPY Gemfile Gemfile.lock ./
RUN bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
    bundle exec bootsnap precompile -j 1 --gemfile

RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash

COPY --chown=rails:rails . .
RUN chown rails:rails /rails

USER 1000:1000
ENTRYPOINT ["/rails/bin/docker-entrypoint"]
EXPOSE 3000
CMD ["./bin/rails", "server"]
